<Window x:Class="SpotifyOverlay.FpsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Settings"
        Height="210" Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="#F2181822"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="3" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="⚡ Widget FPS Limit"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,10"/>

            <!-- Input Box -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FpsTextBox"
                         Grid.Column="0"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Background="#25FFFFFF"
                         Foreground="#FFFFFF"
                         BorderBrush="#44FFFFFF"
                         BorderThickness="1"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         KeyDown="FpsTextBox_KeyDown"/>

                <TextBlock Grid.Column="1"
                           Text="FPS (0 = Auto)"
                           FontSize="11"
                           Foreground="#88FFFFFF"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>

            <!-- Quick Presets -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Button Content="60" Width="38" Height="24" Margin="2,0" Background="#20FFFFFF" Foreground="#EEE" BorderThickness="0" Click="Preset_Click"/>
                <Button Content="120" Width="38" Height="24" Margin="2,0" Background="#20FFFFFF" Foreground="#EEE" BorderThickness="0" Click="Preset_Click"/>
                <Button Content="144" Width="38" Height="24" Margin="2,0" Background="#20FFFFFF" Foreground="#EEE" BorderThickness="0" Click="Preset_Click"/>
                <Button Content="165" Width="38" Height="24" Margin="2,0" Background="#20FFFFFF" Foreground="#EEE" BorderThickness="0" Click="Preset_Click"/>
                <Button Content="240" Width="38" Height="24" Margin="2,0" Background="#20FFFFFF" Foreground="#EEE" BorderThickness="0" Click="Preset_Click"/>
                <Button Content="Auto" Width="44" Height="24" Margin="2,0" Background="#20FFFFFF" Foreground="#EEE" BorderThickness="0" Click="Preset_Click"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="75" Height="28"
                        Background="#20FFFFFF"
                        Foreground="#CCC"
                        BorderThickness="0"
                        Margin="0,0,8,0"
                        Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Apply"
                        Width="85" Height="28"
                        Background="#1DB954"
                        Foreground="#FFF"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="Save_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
