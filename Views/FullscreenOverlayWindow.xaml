<Window x:Class="SpotifyOverlay.FullscreenOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpotifyOverlay"
        mc:Ignorable="d"
        Title="Spotify Fullscreen Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        KeyDown="Window_KeyDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Window.Resources>
        <!-- Modern Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F2141418"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.75" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#0C0C12" ClipToBounds="True">
        
        <!-- Ultra-Optimized Deep Blurred Album Art Background Layer (0% continuous GPU shader overhead) -->
        <Grid Margin="-20">
            <Image x:Name="BlurredBackgroundImage"
                   Stretch="UniformToFill"
                   Opacity="0.45"
                   RenderOptions.BitmapScalingMode="Linear"/>
            
            <!-- Dark Radial Vignette for Contrast -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#40000000" Offset="0.0"/>
                        <GradientStop Color="#C80A0A10" Offset="0.65"/>
                        <GradientStop Color="#F008080C" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Top-Right Hover Area for Close Button (Appears only on hover) -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="100" Height="100"
              Background="Transparent">
            <Button x:Name="BtnExitFullscreen"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,24,28,0"
                    Width="38" Height="38"
                    Background="#35FFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Exit Fullscreen (ESC)"
                    Click="BtnExitFullscreen_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="19">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Center Stage: Cover Art Presentation + Track Metadata -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- Cover Art Section (Left) -->
            <Grid Grid.Column="0" Width="290" Height="290" VerticalAlignment="Center">
                
                <!-- Static Shadow Layer (Never rotates) -->
                <Grid Width="290" Height="290">
                    <Ellipse x:Name="CircleShadowLayer" Width="290" Height="290" Fill="#000000">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="35" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Border x:Name="SquareShadowLayer" Width="270" Height="270" CornerRadius="24" Background="#000000" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="35" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <!-- Mode 1: Spinning Circle Container -->
                <Grid x:Name="CoverCircleContainer"
                      Width="290" Height="290"
                      RenderTransformOrigin="0.5,0.5"
                      UseLayoutRounding="False">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="DiscRotateTransform" Angle="0"/>
                    </Grid.RenderTransform>

                    <!-- Full Album Artwork Clipped to Circle -->
                    <Grid Width="290" Height="290">
                        <Grid.Clip>
                            <EllipseGeometry Center="145,145" RadiusX="145" RadiusY="145"/>
                        </Grid.Clip>

                        <Border x:Name="DefaultArtBorderCircle" Background="#202028">
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 22,12M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"
                                  Fill="#1DB954" Width="110" Height="110" Stretch="Uniform"/>
                        </Border>

                        <Image x:Name="AlbumCoverImageCircle" Stretch="UniformToFill"/>
                    </Grid>

                    <!-- Shiny Realistic Gloss Light Reflection Overlay -->
                    <Ellipse x:Name="DiscGlossOverlay" Width="290" Height="290" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#45FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                <GradientStop Color="#25FFFFFF" Offset="0.8"/>
                                <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Thin Sleek Customizable Outer Ring -->
                    <Ellipse x:Name="DiscOuterRing" Width="290" Height="290" Fill="Transparent" StrokeThickness="2.0" IsHitTestVisible="False"/>
                </Grid>

                <!-- Mode 2: Static Rounded Square Container with Exact Geometric Clipping -->
                <Grid x:Name="CoverSquareContainer"
                      Width="270" Height="270"
                      Visibility="Collapsed">
                    <Grid Width="270" Height="270">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,270,270" RadiusX="24" RadiusY="24"/>
                        </Grid.Clip>
                        <Border x:Name="DefaultArtBorderSquare" Background="#202028">
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,22A10,10 0 0,0 22,12M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"
                                  Fill="#1DB954" Width="110" Height="110" Stretch="Uniform"/>
                        </Border>
                        <Image x:Name="AlbumCoverImageSquare" Stretch="UniformToFill"/>
                    </Grid>

                    <!-- Customizable Outer Square Border with matching radius -->
                    <Border x:Name="SquareOuterRing" Width="270" Height="270" CornerRadius="24" BorderThickness="2.0" Background="Transparent" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <!-- Track Info Section (Right) -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Track Title -->
                <TextBlock x:Name="TrackTitleText"
                           Grid.Row="0"
                           Text="Spotify is not running"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxHeight="90"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.8" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Artist & Album Name -->
                <TextBlock x:Name="ArtistText"
                           Grid.Row="1"
                           Text="Waiting for track playback in Spotify..."
                           FontSize="18"
                           FontWeight="Medium"
                           Foreground="#CCD6E0"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,8,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.7" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Progress Bar & Timeline Section -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Custom Smooth Progress Line / Bar -->
                    <Grid Grid.Row="0" Height="16" Cursor="Hand" MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown">
                        <Border Height="5" CornerRadius="2.5" Background="#35FFFFFF"/>
                        <Border x:Name="ActiveProgressBar"
                                Height="5" CornerRadius="2.5"
                                HorizontalAlignment="Left"
                                Width="0"
                                Background="#1DB954">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Ellipse x:Name="ProgressThumb"
                                 Width="12" Height="12"
                                 Fill="#FFFFFF"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <!-- Timestamps -->
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="CurrentTimeText"
                                   Text="00:00"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#90FFFFFF"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TotalTimeText"
                                   Text="00:00"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#90FFFFFF"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</Window>
