<Window x:Class="SpotifyOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpotifyOverlay"
        mc:Ignorable="d"
        Title="Spotify Overlay"
        Height="115" Width="345"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="80" Top="80"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Window.Resources>
        <!-- Modern Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F2141418"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.65" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right" VerticalOffset="-3">
                                    <Border Background="#F2141418" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="8" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.7" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu" Opened="ContextMenu_Opened">
            <MenuItem x:Name="MenuVisibilityItem" Header="Hide Overlay to Tray" Click="MenuToggleVisibility_Click"/>
            <MenuItem x:Name="MenuFullscreenSubmenu" Header="🖥️ Fullscreen Mode"/>
            
            <MenuItem Header="🖼️ Cover Style">
                <MenuItem x:Name="MenuCoverCircle" Header="Circle (Spinning)" IsCheckable="True" IsChecked="True" Click="MenuCoverCircle_Click"/>
                <MenuItem x:Name="MenuCoverSquare" Header="Square (Static)" IsCheckable="True" IsChecked="False" Click="MenuCoverSquare_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuRingColorSubmenu" Header="🎨 Outer Ring Color">
                <MenuItem Header="Silver / Metallic (CD)" Tag="Silver" Click="MenuRingColor_Click"/>
                <MenuItem Header="Adaptive (Cover Color)" Tag="Adaptive" Click="MenuRingColor_Click"/>
                <MenuItem Header="White" Tag="White" Click="MenuRingColor_Click"/>
                <MenuItem Header="Spotify Green" Tag="SpotifyGreen" Click="MenuRingColor_Click"/>
                <MenuItem Header="Black" Tag="Black" Click="MenuRingColor_Click"/>
                <MenuItem Header="Gold" Tag="Gold" Click="MenuRingColor_Click"/>
                <MenuItem Header="Neon Cyan" Tag="Cyan" Click="MenuRingColor_Click"/>
                <Separator Background="#20FFFFFF"/>
                <MenuItem Header="No Ring (Hidden)" Tag="None" Click="MenuRingColor_Click"/>
            </MenuItem>

            <MenuItem x:Name="MenuBlurItem" Header="✨ Edge Blur Effect" IsCheckable="True" IsChecked="True" Click="MenuBlur_Click"/>

            <Separator Background="#20FFFFFF"/>
            <MenuItem Header="Play / Pause" Click="MenuPlayPause_Click"/>
            <MenuItem Header="Next Track ⏭" Click="MenuNext_Click"/>
            <MenuItem Header="Previous Track ⏮" Click="MenuPrev_Click"/>
            <Separator Background="#20FFFFFF"/>
            <MenuItem x:Name="MenuMarqueeItem" Header="Marquee Scrolling" IsCheckable="True" IsChecked="True" Click="MenuMarquee_Click"/>
            <MenuItem Header="⚡ FPS Settings..." Click="MenuFps_Click"/>
            <MenuItem x:Name="MenuTopmostItem" Header="Always on Top" IsCheckable="True" IsChecked="True" Click="MenuTopmost_Click"/>
            <MenuItem x:Name="MenuLockItem" Header="Lock Position" IsCheckable="True" IsChecked="False" Click="MenuLock_Click"/>
            <MenuItem x:Name="MenuAutoStartupItem" Header="🚀 Run at Windows Startup" IsCheckable="True" IsChecked="False" Click="MenuAutoStartup_Click"/>
            <Separator Background="#20FFFFFF"/>
            <MenuItem Header="Exit Application" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Main Container -->
    <Grid Margin="14" VerticalAlignment="Center" HorizontalAlignment="Left">
        
        <!-- Short Compact Translucent Card with Cached Blur Layer (0% continuous GPU cost) -->
        <Grid Margin="44,2,0,2" Width="238" Height="60" HorizontalAlignment="Left">
            
            <!-- Ultra-efficient cached edge blur -->
            <Border x:Name="SmudgeBlurLayer"
                    Margin="-1.5"
                    CornerRadius="15"
                    Background="#88181822">
                <Border.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1.0" SnapsToDevicePixels="True"/>
                </Border.CacheMode>
                <Border.Effect>
                    <BlurEffect Radius="4" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <!-- Translucent Core Glass Layer with GPU Bitmap Caching -->
            <Border x:Name="CardCoreBorder"
                    CornerRadius="14"
                    Background="#9014141C">
                <Border.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1.0" SnapsToDevicePixels="True"/>
                </Border.CacheMode>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- Content Area inside the Card -->
            <Grid Margin="44,4,10,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Track Title Container (Supports both Marquee and Ellipsis mode) -->
                <Grid x:Name="TitleContainer" Grid.Row="0" ClipToBounds="True" Height="19" SizeChanged="TitleContainer_SizeChanged">
                    
                    <!-- Mode A: Static Ellipsis TextBlock (when marquee is turned off) -->
                    <TextBlock x:Name="TrackTitleEllipsisText"
                               Text="Spotify is not running"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- Mode B: Infinite Smooth Canvas Marquee -->
                    <Canvas x:Name="MarqueeTrack" HorizontalAlignment="Left" VerticalAlignment="Center" Height="19" UseLayoutRounding="False">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="MarqueeTransform" X="0"/>
                        </Canvas.RenderTransform>

                        <!-- First Title Copy -->
                        <TextBlock x:Name="TrackTitleText1"
                                   Text="Spotify is not running"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Canvas.Left="0"
                                   Canvas.Top="0"/>

                        <!-- Second Title Copy for Seamless Infinite Loop -->
                        <TextBlock x:Name="TrackTitleText2"
                                   Text=""
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Canvas.Top="0"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>

                <!-- Artist Text -->
                <TextBlock x:Name="ArtistText"
                           Grid.Row="1"
                           Text="Waiting for track playback..."
                           FontSize="10"
                           FontWeight="Normal"
                           Foreground="#CCD4DC"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2"/>

                <!-- Progress Bar & Timeline Section -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>

                    <!-- Elapsed Time -->
                    <TextBlock x:Name="CurrentTimeText"
                               Grid.Column="0"
                               Text="00:00"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                    <!-- Custom Smooth Progress Line / Bar -->
                    <Grid Grid.Column="1" Margin="4,0" VerticalAlignment="Center" Height="10" Cursor="Hand" MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown">
                        <!-- Background track -->
                        <Border Height="2.5" CornerRadius="1.25" Background="#30FFFFFF"/>
                        <!-- Active progress track -->
                        <Border x:Name="ActiveProgressBar"
                                Height="2.5" CornerRadius="1.25"
                                HorizontalAlignment="Left"
                                Width="0"
                                Background="#1DB954"/>
                        <!-- Floating Thumb Knob (●) -->
                        <Ellipse x:Name="ProgressThumb"
                                 Width="6.5" Height="6.5"
                                 Fill="#FFFFFF"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,0"/>
                    </Grid>

                    <!-- Total Duration -->
                    <TextBlock x:Name="TotalTimeText"
                               Grid.Column="2"
                               Text="00:00"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#80FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Cover Art Presentation Container -->
        <Grid Width="82" Height="82" HorizontalAlignment="Left" VerticalAlignment="Center">
            
            <!-- Static Shadow Layer (Never rotates) -->
            <Grid Width="82" Height="82">
                <Ellipse x:Name="CircleShadowLayer" Width="82" Height="82" Fill="#000000">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Border x:Name="SquareShadowLayer" Width="74" Height="74" CornerRadius="12" Background="#000000" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- Mode 1: Spinning Circle Cover Art -->
            <Grid x:Name="CoverCircleContainer"
                  Width="82" Height="82"
                  RenderTransformOrigin="0.5,0.5"
                  UseLayoutRounding="False">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="DiscRotateTransform" Angle="0"/>
                </Grid.RenderTransform>

                <!-- Full Album Artwork Clipped to Circle -->
                <Grid Width="82" Height="82">
                    <Grid.Clip>
                        <EllipseGeometry Center="41,41" RadiusX="41" RadiusY="41"/>
                    </Grid.Clip>
                    
                    <Border x:Name="DefaultArtBorderCircle" Background="#202028">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 22,12M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"
                              Fill="#1DB954" Width="36" Height="36" Stretch="Uniform"/>
                    </Border>

                    <Image x:Name="AlbumCoverImageCircle" Stretch="UniformToFill"/>
                </Grid>

                <!-- Shiny Realistic Gloss Light Reflection Overlay -->
                <Ellipse x:Name="DiscGlossOverlay" Width="82" Height="82" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#45FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                            <GradientStop Color="#25FFFFFF" Offset="0.8"/>
                            <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Thin Sleek Customizable Outer Ring -->
                <Ellipse x:Name="DiscOuterRing" Width="82" Height="82" Fill="Transparent" StrokeThickness="1.2" IsHitTestVisible="False"/>
            </Grid>

            <!-- Mode 2: Static Modern Rounded Square Cover Art with Exact Geometric Clipping -->
            <Grid x:Name="CoverSquareContainer"
                  Width="74" Height="74"
                  Visibility="Collapsed">
                
                <!-- Perfectly clipped rounded image (zero corner leakage) -->
                <Grid Width="74" Height="74">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,74,74" RadiusX="12" RadiusY="12"/>
                    </Grid.Clip>
                    <Border x:Name="DefaultArtBorderSquare" Background="#202028">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 22,12M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,11A1,1 0 0,1 13,12A1,1 0 0,1 12,13A1,1 0 0,1 11,12A1,1 0 0,1 12,11Z"
                              Fill="#1DB954" Width="36" Height="36" Stretch="Uniform"/>
                    </Border>
                    <Image x:Name="AlbumCoverImageSquare" Stretch="UniformToFill"/>
                </Grid>

                <!-- Customizable Outer Square Border with matching radius -->
                <Border x:Name="SquareOuterRing" Width="74" Height="74" CornerRadius="12" BorderThickness="1.2" Background="Transparent" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

    </Grid>
</Window>
